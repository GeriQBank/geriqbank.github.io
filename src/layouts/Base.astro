---
import '../styles/global.css';
import { SITE } from '../site.config.mjs';
import { url } from '../lib/url.js';

const { title, description = SITE.description, current = '', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const nav = [
  { href: '/questions/', label: 'Questions', key: 'questions' },
  { href: '/essays/', label: 'Essays', key: 'essays' },
  { href: '/sunday-rounds/', label: 'Newsletter', key: 'newsletter' },
  { href: '/about/', label: 'About', key: 'about' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {(noindex || SITE.preview) && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..600&display=swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="wordmark" href={url('/')}>
        <svg width="22" height="18" viewBox="0 0 22 18" aria-hidden="true"><path d="M3 3 L3.5 15 M7.5 2.5 L7.5 15 M12 3 L11.5 15.5 M16.5 2.5 L17 15 M1 12 L20 5" /></svg>
        {SITE.name}
      </a>
      <div class="header-actions">
        <a class="icon-link" href={url('/search/')} aria-label="Search">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="9.5" cy="9.5" r="6.5" /><path d="M14.5 14.5 L20 20" /></svg>
        </a>
        <a class="button button-outline button-small" href={SITE.newsletterUrl}>Subscribe</a>
      </div>
    </div>
    <nav class="site-nav" aria-label="Sections">
      <div class="wrap nav-row">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
    </nav>
  </header>

  <main id="main" class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p class="footer-name">{SITE.name}</p>
      <p>Written by {SITE.author}, {SITE.authorRole}. Free to read.</p>
      <p class="footer-muted">For exam revision, not clinical guidance. Spotted a mistake? <a href={SITE.reportErrorUrl}>Report it</a>.</p>
    </div>
  </footer>
</body>
</html>
