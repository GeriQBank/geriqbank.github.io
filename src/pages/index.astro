---
import Base from '../layouts/Base.astro';
import QuestionBank from '../components/QuestionBank.astro';
import Subscribe from '../components/Subscribe.astro';
import data, { PAPERS } from '../lib/qbank.js';

const total = PAPERS.reduce((sum, p) => sum + data[p.key].questions.length, 0);
---
<Base current="bank">
  <section class="page-top">
    <h1>MD Geriatrics question bank</h1>
    <p class="lede">All {total} Paper II, III and IV questions, with the ones that keep coming back ranked first. Free for everyone.</p>
  </section>
  <QuestionBank />
  <Subscribe />
</Base>
