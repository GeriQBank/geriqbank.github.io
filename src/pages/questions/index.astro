---
// The question bank now lives on the home page; this keeps old links working.
import { url } from '../../lib/url.js';

const target = url('/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Question bank</title>
</head>
<body>
  <p>The question bank has moved to the <a href={target}>home page</a>.</p>
</body>
</html>
